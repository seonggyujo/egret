// Windows resources for egret.exe and egret.com: the icon, the manifest and
// the version block (Windows shows its description in the startup app list).
#include <winuser.h>
#include <winver.h>

1 ICON "egret.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "egret.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 1, 0, 0
PRODUCTVERSION 0, 1, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "egret"
      VALUE "ProductName", "egret"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
